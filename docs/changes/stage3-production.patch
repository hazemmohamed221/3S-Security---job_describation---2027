+    for table, domain in (('job_descriptions', CardStatus), ('modification_requests', ReviewStatus),
+                          ('interview_schedule', InterviewStatus)):
+        allowed = ','.join("'" + v.replace("'", "''") + "'" for v in ALIASES[domain])
+        for action in ('INSERT', 'UPDATE OF status'):
