+    CardStatus: dict(zip(('Draft', 'Under Review', 'Pending Review', 'Approved', 'Rejected'),
+                        (CardStatus.DRAFT, CardStatus.PENDING_REVIEW, CardStatus.PENDING_REVIEW,
